# =====================================================
# Vendedor Imortal — Configuracoes de Ambiente
# Copie este arquivo para .env e preencha os valores
# =====================================================

# --- Microsoft Azure App Registration ---
AZURE_CLIENT_ID=SEU_AZURE_CLIENT_ID
AZURE_TENANT_ID=SEU_AZURE_TENANT_ID
AZURE_CLIENT_SECRET=SEU_AZURE_CLIENT_SECRET

# --- AI Engines ---
# Prioridade de fallback (esquerda -> direita)
LLM_PROVIDER_ORDER=gemini,groq,openai,grok
# Opcional: força um primario no topo da fila
LLM_PROVIDER=gemini

# Gemini (Google)
GEMINI_API_KEY=SUA_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq
GROQ_API_KEY=SUA_GROQ_API_KEY
GROQ_MODEL_TEXT=llama-3.3-70b-versatile
GROQ_MODEL_VISION=llama-3.2-11b-vision-preview

# OpenAI
OPENAI_API_KEY=SUA_OPENAI_API_KEY
OPENAI_MODEL_TEXT=gpt-4o-mini
OPENAI_MODEL_VISION=gpt-4o-mini

# Grok (xAI)
XAI_API_KEY=SUA_XAI_API_KEY
# Alias opcional
GROK_API_KEY=SUA_XAI_API_KEY
GROK_MODEL_TEXT=grok-4-latest
GROK_MODEL_VISION=grok-4-latest

# --- Flask ---
FLASK_SECRET_KEY=UMA_CHAVE_SECRETA_LONGA

# --- Agente ---
EMAILS_PER_RUN=4
POLL_INTERVAL_MINUTES=5
GEMINI_DELAY_SECONDS=5
# Novo template padrao de proposta no corpo do e-mail
USE_PROPOSTA_MODELO=true
