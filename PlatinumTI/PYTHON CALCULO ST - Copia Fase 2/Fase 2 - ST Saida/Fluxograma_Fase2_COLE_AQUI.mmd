flowchart TD

    A([INICIO])
    A --> P1

    subgraph P1["PAINEL 1 - Configurar a Operacao"]
        direction TB
        S1[/"Seleciona UF de Destino<br/>ex: SP, MG, BA..."/]
        S1 --> S2[/"Mercadoria IMPORTADA?<br/>Checkbox: Nao ou Sim"/]
        S2 --> S3[/"Consumidor Final?<br/>Dropdown: NAO ou SIM"/]
        S3 --> S4[/"Contribuinte com IE?<br/>Dropdown: NAO ou SIM"/]
    end

    P1 --> AUTO1
    AUTO1["Sistema calcula automaticamente:<br/>Aliq. Interestadual: Importada=4% / Sul-Sudeste=7% / Demais=12%<br/>Aliq. Interna do estado destino: tabela ICMS 2026"]

    AUTO1 --> P2

    subgraph P2["PAINEL 2 - Selecionar o Produto"]
        direction TB
        S5[/"Digita NCM ou nome do produto<br/>no campo Buscar"/]
        S5 --> S6[/"Clica no produto desejado<br/>na lista de resultados"/]
    end

    P2 --> AUTO2
    AUTO2["Sistema le da planilha MATRIZ_ST_SAIDA_ver2.xlsx:<br/>Acordo ST com a UF: SIM ou NAO<br/>MVA - Cons. Final - Contribuinte - Importado<br/>Preenche campos do Painel 1 automaticamente"]

    AUTO2 --> D1

    D1{{"Acordo ST com<br/>esta UF?"}}

    D1 -- "NAO<br/>linha vermelha na lista" --> SEMST
    D1 -- "SIM<br/>linha verde na lista" --> D2

    SEMST["Sem ST a reter<br/>Emite NF normalmente<br/>Apenas ICMS proprio"]
    SEMST --> FIM

    D2{{"Consumidor Final = SIM?"}}

    D2 -- "NAO - Revenda" --> ROTA_A
    D2 -- "SIM" --> D3

    D3{{"Contribuinte com IE = SIM?"}}

    D3 -- "NAO<br/>Pessoa Fisica ou empresa sem IE" --> ROTA_B
    D3 -- "SIM<br/>Empresa com Inscricao Estadual" --> ROTA_C

    ROTA_A["ROTA A - REVENDA<br/>MVA preenchida automaticamente da planilha<br/>Campo editavel se necessario"]
    ROTA_B["ROTA B - DIFAL BASE UNICA<br/>CFOP 6108<br/>Preco digitado = valor SEM imposto"]
    ROTA_C["ROTA C - DIFAL BASE DUPLA<br/>CFOP 6403<br/>Preco digitado = valor COM frete"]

    ROTA_A --> P3
    ROTA_B --> P3
    ROTA_C --> P3

    subgraph P3["PAINEL 3 - Informar os Valores"]
        direction TB
        S7[/"Valor Mercadoria R$: _______"/]
        S7 --> S8[/"Frete e Despesas R$: _______ (default 0,00)"/]
        S8 --> S9[/"MVA %: _______ (preenchido auto - editavel)"/]
        S9 --> S10[/"Clica: CALCULAR ST"/]
    end

    P3 --> CALC

    subgraph CALC["SISTEMA CALCULA - conforme a rota"]
        direction TB
        CA["ROTA A - ICMS-ST com MVA<br/>1. VT = Valor + Frete<br/>2. ICMS Proprio = VT x Aliq. Inter.<br/>3. Base ST = VT x (1 + MVA%)<br/>4. ICMS-ST = Base ST x Aliq. Intra - ICMS Proprio<br/>5. Total NF = VT + ICMS-ST"]
        CB["ROTA B - DIFAL BASE UNICA CFOP 6108<br/>1. Novo Valor = Valor / (1 - Aliq. Intra)<br/>2. ICMS Proprio = Novo Valor x Aliq. Inter.<br/>3. DIFAL = Novo Valor x Aliq. Intra - ICMS Proprio<br/>4. Total NF = Novo Valor (imposto embutido no preco)"]
        CC["ROTA C - DIFAL BASE DUPLA CFOP 6403<br/>1. VT = Valor + Frete<br/>2. ICMS Proprio = VT x Aliq. Inter.<br/>3. Base Dupla = (VT - ICMS Proprio) / (1 - Aliq. Intra)<br/>4. DIFAL = Base Dupla x Aliq. Intra - ICMS Proprio<br/>5. Total NF = VT + DIFAL"]
    end

    CALC --> DEMO

    DEMO["DEMONSTRATIVO exibido na tela:<br/>Aliq. Interestadual - Aliq. Interna Destino - MVA<br/>Valor Total NF - ICMS Proprio Origem RJ<br/>Base de Calculo ST<br/>ICMS-ST / DIFAL A RETER<br/>TOTAL DA NOTA FISCAL"]

    DEMO --> FIN

    subgraph FIN["Acoes Finais"]
        direction TB
        S11[/"Copiar Resumo - opcional"/]
        S11 --> S12[/"Limpar - iniciar nova operacao"/]
    end

    FIN --> FIM

    FIM([FIM])

    style A fill:#217346,color:#fff
    style FIM fill:#C00000,color:#fff
    style SEMST fill:#FDECEA,stroke:#C00000
    style D1 fill:#FFF8E1,stroke:#E6A817
    style D2 fill:#FFF8E1,stroke:#E6A817
    style D3 fill:#FFF8E1,stroke:#E6A817
    style ROTA_A fill:#E3F2FD,stroke:#1565C0
    style ROTA_B fill:#F3E5F5,stroke:#6A1B9A
    style ROTA_C fill:#E8F5E9,stroke:#1B5E20
    style CA fill:#E3F2FD,stroke:#1565C0
    style CB fill:#F3E5F5,stroke:#6A1B9A
    style CC fill:#E8F5E9,stroke:#1B5E20
    style DEMO fill:#FFF9C4,stroke:#F9A825
    style AUTO1 fill:#F5F5F5,stroke:#9E9E9E
    style AUTO2 fill:#F5F5F5,stroke:#9E9E9E
